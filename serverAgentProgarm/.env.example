# ===== 必填：目标机 SSH 与数据库 =====
SERVER_HOST=your-server.example.com
SERVER_USER=opsagent
KEY_PATH=/absolute/path/to/private_key
DB_URL=sqlite:///data/agent.db
LOG_LEVEL=INFO

# ===== 选填：运行策略（括号内为默认值） =====
SERVER_PORT=22
MONITOR_INTERVAL=30
WATCHED_SERVICES=ssh,docker
POLICY_MODE=standard
APPROVAL_TTL_MINUTES=60
INVESTIGATE_MAX_RETRIES=2
MAX_OUTPUT_CHARS=8000
MEMORY_CONSOLIDATE_THRESHOLD=10
COMPACT_TOKEN_THRESHOLD=24000
# ALERT_WEBHOOK_URL=https://example.com/webhook

# ===== 必填：OpenAI 兼容 LLM 服务 =====
API_KEY=replace-with-llm-api-key
BASE_URL=https://api.example.com/v1
MODEL_ID=your-model-id

# ===== 选填：检测阈值（不配置则使用括号内默认值） =====
THRESHOLD_CPU_PCT=85
THRESHOLD_MEM_PCT=85
THRESHOLD_DISK_PCT=80
THRESHOLD_SUSTAIN=3
THRESHOLD_SERVICE_SUSTAIN=2

# ===== 可选：Verified Recovery RAG（默认开启；可设 false 关闭） =====
RECOVERY_RAG_ENABLED=true
RECOVERY_INDEX_PATH=.knowledge/recovery.sqlite
RECOVERY_EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
RECOVERY_EMBEDDING_MODEL=qwen3-embedding:0.6b
RECOVERY_EMBEDDING_TIMEOUT_SECONDS=30
RECOVERY_EMBEDDING_BATCH_SIZE=16
RECOVERY_TOP_K=5
RECOVERY_DENSE_MIN_SCORE=0.5
RECOVERY_CANDIDATE_LIMIT=20
RECOVERY_RRF_K=60
RECOVERY_CONTEXT_MAX_CHARS=6000
RECOVERY_CASE_ORIGIN=real
RECOVERY_AUTO_INDEX_ENABLED=true
RECOVERY_INDEX_DEBOUNCE_SECONDS=3
RECOVERY_INDEX_RETRY_SECONDS=30
RECOVERY_INDEX_MAX_ATTEMPTS=3

# 按目标服务器显式增加服务重启预案和后置端口检查，例如：
# RECOVERY_SERVICE_PORTS=mysql:3306,postgresql:5432,redis:6379

# ===== 可选：MCP Agent 只读调查工具（默认关闭） =====
MCP_ENABLED=false
MCP_CONFIG_PATH=mcp.json
# env_vars 只传递显式列出的进程环境变量；外部 Server 不继承整个 .env。
